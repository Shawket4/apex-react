VITE_API_BASE_URL=https://apextransport.ddns.net:3001
VITE_API_BASE_URL_RUST=https://apextransport.ddns.net:3002
VITE_APP_NAME=Apex

# ---- Error reporting (optional) --------------------------------------------
# Unset or blank disables Sentry entirely; the app runs unchanged.
# VITE_SENTRY_DSN=https://<key>@sentry.madar-pos.cloud/<project>
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_RELEASE=apex-react@<git sha>
#
# Source maps upload only when CI supplies ALL THREE of these, and are deleted
# from dist immediately after upload so users never receive them. They are CI
# secrets and must not be committed:
#   SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT
#   SENTRY_URL=https://sentry.madar-pos.cloud   (self-hosted, so this is needed)

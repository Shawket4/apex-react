# Loaded by every `vite build` (mode production) on top of .env: the deploy
# workflow, Tauri release builds and a local `npm run build`. Not by `npm run dev`.

# Leaflet everywhere, the Google SDK never loaded: the Google Maps key's billing
# is off, so Google draws dimmed maps watermarked "For development purposes
# only". Set to `auto` (Google, Leaflet if it fails) once billing is fixed.
VITE_MAP_PROVIDER=leaflet
